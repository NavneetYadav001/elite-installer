#!/usr/bin/env bash
#
# ELITE INSTALLER bootstrap - downloads the installer package from YOUR distribution endpoint, verifies its SHA-256,
# unpacks it in a private temporary folder and starts it. Generated by tools/build-dist.sh; do not edit the markers.
#
#   curl -fsSL <ENDPOINT>/get-elite.sh | sudo bash -s -- install --github OWNER/REPO
#
set -Eeuo pipefail
ENDPOINT="@@ENDPOINT@@"
PKG="elite-installer-@@VERSION@@.tar.gz"
EXPECTED_SHA256="@@SHA256@@"

if [[ "$ENDPOINT" == *"@@"* ]]; then
  echo "ERROR: this bootstrap has not been configured with a distribution endpoint (run tools/build-dist.sh --endpoint https://...)." >&2
  exit 1
fi
[ "$(id -u)" -eq 0 ] || { echo "ERROR: run as root, e.g.  curl -fsSL ${ENDPOINT}/get-elite.sh | sudo bash -s -- install --github OWNER/REPO" >&2; exit 1; }
for t in curl tar sha256sum python3; do command -v "$t" >/dev/null 2>&1 || { echo "ERROR: $t is required." >&2; exit 1; }; done

WORK="$(mktemp -d /var/tmp/elite-bootstrap.XXXXXXXX)"
chmod 0700 "$WORK"
trap 'rm -rf "$WORK"' EXIT

echo "Downloading ${PKG} ..."
curl -fsSL --proto '=https' --tlsv1.2 --retry 3 --max-filesize 20000000 -o "${WORK}/${PKG}" "${ENDPOINT}/${PKG}"
ACTUAL="$(sha256sum "${WORK}/${PKG}" | awk '{print $1}')"
if [ "$ACTUAL" != "$EXPECTED_SHA256" ]; then
  echo "ERROR: checksum mismatch - the installer package was NOT run." >&2
  echo "       expected ${EXPECTED_SHA256}" >&2
  echo "       got      ${ACTUAL}" >&2
  exit 1
fi
mkdir "${WORK}/pkg"
tar -xzf "${WORK}/${PKG}" -C "${WORK}/pkg" --no-same-owner --no-same-permissions
[ -x "${WORK}/pkg/elite-installer/elite-installer" ] || chmod +x "${WORK}/pkg/elite-installer/elite-installer"
[ -f "${WORK}/pkg/elite-installer/elite_installer/cli.py" ] || { echo "ERROR: unexpected package layout." >&2; exit 1; }
"${WORK}/pkg/elite-installer/elite-installer" "$@"
